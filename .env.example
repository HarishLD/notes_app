# Pooled connection string — used by the app at runtime (lib/prisma.ts).
DATABASE_URL=

# Direct (unpooled) connection string — used for migrations only (prisma.config.ts).
DIRECT_URL=

# HS256 signing secret for session JWTs (lib/auth/jwt.ts). Required — the app
# throws at module load if this is missing.
JWT_SECRET=

# Reviewer test account seeded by prisma/seed.ts. Optional — sensible
# defaults are used if unset. Set these to control what the reviewer signs
# in with without hardcoding it in source.
SEED_REVIEWER_EMAIL=
SEED_REVIEWER_PASSWORD=

# `npm run test` runs against a separate Neon branch, never the dev database.
# Create a file named .env.test (gitignored, not this one) with its own
# DATABASE_URL and JWT_SECRET pointing at that branch. vitest.config.mts
# loads it automatically and it overrides the values above for test runs.
